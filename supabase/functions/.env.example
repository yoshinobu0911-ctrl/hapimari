# ============================================================
# Edge Function のシークレット（M7.1 Stripe決済）
#
# ★ このファイルは「見本」です。実際の値を書いた .env は Git に入りません（.gitignore 済み）。
# ★ ここに書く値はすべてサーバー側専用です。apps/mobile には絶対に入れないでください。
#
# 使い方:
#   ローカル:  このファイルを同じ場所に `.env` としてコピーし、値を埋める
#              → supabase functions serve --env-file supabase/functions/.env
#   本番/検証: supabase secrets set --env-file supabase/functions/.env
#              （または Supabase ダッシュボード > Edge Functions > Secrets）
# ============================================================

# --- Stripe のキー ------------------------------------------------
# 【推奨】シークレットキー(sk_)ではなく「制限付きキー(rk_)」を使う。
#   Stripe ダッシュボード > 開発者 > APIキー > 制限付きキーを作成
#   必要な権限だけを付ける:
#     Customers            = 書き込み
#     Checkout Sessions    = 書き込み
#     Subscriptions        = 書き込み
#     Prices               = 読み取り
#     （それ以外はすべて「なし」。返金・送金の権限は付けない）
#   → 万一漏れても被害を最小化できる
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook の署名シークレット
#   ローカル: stripe listen --forward-to http://127.0.0.1:54321/functions/v1/stripe-webhook
#             を実行すると whsec_... が表示される
#   本番:     Stripe ダッシュボード > 開発者 > Webhook でエンドポイントを登録すると発行される
#   登録するイベント:
#     checkout.session.completed
#     customer.subscription.created
#     customer.subscription.updated
#     customer.subscription.deleted
#     customer.subscription.paused
#     customer.subscription.resumed
#     invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- プランごとの Price ID ----------------------------------------
# Stripe ダッシュボード > 商品 で、プランごとに「商品」を1つずつ作り、
# それぞれに JPY・税込金額・繰り返し請求の Price を1つ登録する。
#   1ヶ月プラン: 4,980円 / 1ヶ月ごと
#   3ヶ月プラン: 11,940円 / 3ヶ月ごと
#   6ヶ月プラン: 16,680円 / 6ヶ月ごと
# ※ 金額はコードに持たない。Stripe 側の登録が常に正。
STRIPE_PRICE_MALE_1M=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MALE_3M=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MALE_6M=price_xxxxxxxxxxxxxxxxxxxxxxxx

# --- アプリ側の戻り先URL ------------------------------------------
# 決済完了・中断のあとにブラウザが戻ってくる先。末尾のスラッシュは付けない。
#   ローカル(Expo Web): http://localhost:8081
#   本番:               https://（取得したドメイン）
APP_BASE_URL=http://localhost:8081
