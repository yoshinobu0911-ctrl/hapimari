# Supabaseローカル環境（supabase start の出力値）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase start の anon key>
# 管理画面はservice_roleで審査・通報対応を行う（クライアントに絶対に出さないこと）
SUPABASE_SERVICE_ROLE_KEY=<supabase start の service_role key>
# 管理画面のBasic認証パスワード（ユーザー名は admin 固定）。
# 未設定時: 開発中は素通し / 本番は503で全遮断。本番では必ず設定する。
ADMIN_PASSWORD=<管理画面のパスワード>
